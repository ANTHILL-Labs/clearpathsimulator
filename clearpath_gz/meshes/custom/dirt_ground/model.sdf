<?xml version="1.0"?>
<sdf version="1.10">
  <model name="dirt_ground">
    <static>true</static>
    <link name="ground_link">

      <!-- ✅ Collision -->
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- ✅ Visual -->
      <visual name="visual">
        <geometry>
          <heightmap>
            <uri>materials/textures/dirt_height.png</uri>
            <size>100 100 0.1</size>
            <pos>0 0 0</pos>

            <texture>
              <diffuse>materials/textures/dirt_albedo.jpg</diffuse>
              <normal>materials/textures/dirt_albedo.jpg</normal> <!-- ✅ Dummy normal -->
              <size>2</size> <!-- each texture tile = 2m -->
            </texture>
          </heightmap>
        </geometry>

        <!-- ✅ Material -->
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>materials/textures/dirt_albedo.jpg</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.7</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
